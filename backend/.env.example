PORT=3000

# Supabase project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# The service_role key bypasses row level security. NEVER commit this file and
# never ship it to the browser. If it is ever exposed, rotate it immediately
# in the Supabase dashboard.
SUPABASE_SERVICE_KEY=your-service-role-key

# Only used to verify bearer tokens and create sessions. Safe to use server-side.
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# PayFast is not wired up. Cash on collection is the only method today.
# Fill these in when you implement backend/config/paymentProvider.js.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
