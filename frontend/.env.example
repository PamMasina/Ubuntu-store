# Both are safe to expose in the browser. Supabase RLS is what protects the
# data for these; the API uses its own service_role key for privileged writes.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave as /api to use the Vite dev proxy in vite.config.js. Set an absolute URL
# only if the API is hosted on a different domain in production.
VITE_API_BASE=/api

# Where the dev proxy forwards /api. Change if your API runs on another port.
VITE_PROXY_TARGET=http://localhost:3000
